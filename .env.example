# Copy to .env to override the defaults in settlement/config.py.
# The defaults already match docker-compose.yml, so .env is optional for local dev.
DATABASE_URL=postgresql+psycopg://settlement:settlement-local-dev@127.0.0.1:5432/settlement
REDIS_URL=redis://127.0.0.1:6379/0
RAIL_URL=http://127.0.0.1:9000
RAIL_TIMEOUT_SECONDS=2
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
